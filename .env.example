# Copie para .env e preencha. O .env nunca vai para o Git.

# Texto longo e aleatório. Gere com: openssl rand -hex 32
SEGREDO_SESSAO=

# Arquivo do banco de dados
BANCO=rebanho.db

# Pasta dos backups diários (os 14 mais recentes são mantidos).
# Dica: uma pasta do iCloud Drive ou Google Drive guarda uma cópia fora do computador.
PASTA_BACKUP=backups
