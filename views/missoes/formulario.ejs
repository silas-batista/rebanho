<%- include("../_topo", { titulo }) %>
<h1><%= titulo %></h1>

<% if (erro) { %><p role="alert" class="erro"><%= erro %></p><% } %>

<form method="post" action="<%= acao %>">
  <label for="nome">Nome do projeto *</label>
  <input id="nome" name="nome" required value="<%= dados.nome || '' %>">

  <label for="local">Local (país, cidade ou região)</label>
  <input id="local" name="local" value="<%= dados.local || '' %>">

  <label for="descricao">Descrição</label>
  <input id="descricao" name="descricao" value="<%= dados.descricao || '' %>">

  <div class="acoes"><a href="/missoes">Cancelar</a> <button type="submit">Salvar</button></div>
</form>
<% if (id) { %><%- include("../_excluir", { acao: `/missoes/${id}/excluir`, rotulo: "Excluir projeto e seus missionários" }) %><% } %>
<%- include("../_rodape") %>
