<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · Rebanho</title>
  <link rel="stylesheet" href="/estilo.css">
</head>
<body>
  <header>
    <a href="/" class="marca">Rebanho</a>
    <nav aria-label="Principal">
      <a href="/agenda">Agenda</a>
      <a href="/missoes">Missões</a>
      <% if (usuario) { %><a href="/contatos">Contatos</a><% } %>
      <% if (usuario?.perfil === "secretaria") { %><a href="/pessoas">Pessoas</a><a href="/usuarios">Usuários</a><% } %>
      <% if (usuario) { %><a href="/minha-senha">Minha senha</a><% } %>
    </nav>
    <% if (usuario) { %>
      <form method="post" action="/sair" class="sair"><button type="submit">Sair</button></form>
    <% } else { %>
      <a href="/entrar" class="sair">Entrar</a>
    <% } %>
  </header>
